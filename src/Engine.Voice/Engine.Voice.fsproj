<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ADR 0011 E7 — the self-voicing channel's Windows back-end
      (SAPI via System.Speech). The ONLY Engine.* assembly with
      a Windows TFM besides the host: it renders audio, it is a
      channel implementation, and it is swappable behind the
      platform-free ISpeechSink contract in Engine.Core
      (RELAUNCH-SPEC §4.6 / §14.10).
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Engine.Voice</RootNamespace>
    <AssemblyName>Engine.Voice</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SapiSink.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="System.Speech" />
    <ProjectReference Include="..\Engine.Core\Engine.Core.fsproj" />
  </ItemGroup>

</Project>
