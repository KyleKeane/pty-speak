<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ADR 0011 E1 — the participant seam's transport layer
      (RELAUNCH-SPEC §0.2 component 6 / §12). Process spawning
      is BCL (System.Diagnostics.Process), so the TFM stays
      plain net9.0; everything translation-shaped stays pure in
      Engine.Core.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Engine.Participants</RootNamespace>
    <AssemblyName>Engine.Participants</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ClaudeCli.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <ProjectReference Include="..\Engine.Core\Engine.Core.fsproj" />
  </ItemGroup>

</Project>
