<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ADR 0011 E1 — the interaction engine's pure core targets
      plain net9.0 (NOT net9.0-windows): the RELAUNCH-SPEC
      §14.10 portable-core principle made structural. Platform
      types cannot be referenced because the platform TFM is
      absent; the portability-lint CI job additionally bans
      WPF/Win32 opens, P/Invoke, and Terminal.* dependencies.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Engine.Core</RootNamespace>
    <AssemblyName>Engine.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Chunk.fs" />
    <Compile Include="ChunkTree.fs" />
    <!--
      ADR 0011 E4 — the participant-stream vocabulary + the
      Claude CLI stream-json parser (pure; System.Text.Json is
      inbox on net9.0, no package needed).
    -->
    <Compile Include="AgentEvent.fs" />
    <Compile Include="ClaudeStreamJson.fs" />
    <!--
      ADR 0011 E2 — markdown → chunk-spec decomposition (the
      chunk grain). Markdig is platform-free and already in the
      central package set (Terminal.Core uses it for the manual
      tests HTML).
    -->
    <Compile Include="MarkdownChunker.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

</Project>
