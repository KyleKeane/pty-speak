<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ADR 0012 S4 — the spatial-cue renderer: a universal-
      event-bus consumer that renders `SpatialCue.Cue` data as
      stereo-panned tones (NAudio / WASAPI). Windows TFM
      because it renders audio; the cue MODEL stays in the
      platform-free Engine.Core. An HRTF renderer is a later
      sibling behind the same cue data.
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Engine.Audio</RootNamespace>
    <AssemblyName>Engine.Audio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SpatialPlayer.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="NAudio" />
    <ProjectReference Include="..\Engine.Core\Engine.Core.fsproj" />
  </ItemGroup>

</Project>
